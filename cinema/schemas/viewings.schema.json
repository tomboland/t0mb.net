{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "viewings",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "film": {
        "type": "string",
        "minLength": 1
      },
      "date": {
        "type": "string",
        "format": "date"
      },
      "rewatch": {
        "type": "boolean"
      },
      "rating": {
        "type": [
          "string",
          "number",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "film",
      "date"
    ]
  }
}
